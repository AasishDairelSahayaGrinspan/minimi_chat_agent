# Copy this file to .env and fill in what you have. Every key is optional:
# the agent runs with zero keys (DuckDuckGo search + extractive answers).

# Optional. Unlocks fluent LLM-written answers (OpenAI chat completions).
OPENAI_API_KEY=

# Optional. Which OpenAI model to use when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini

# Optional. Unlocks the Tavily search provider (best result quality and dates).
TAVILY_API_KEY=

# Optional. Unlocks the Brave Search provider, used when Tavily is not set.
BRAVE_API_KEY=

# Optional. Port the server listens on. Defaults to 3000.
PORT=3000
